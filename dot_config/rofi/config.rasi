configuration {
    modi: "drun,run,window";
    show-icons: true;
    matching: "fuzzy";
    sort: true;
    sorting-method: "fzf";
    cycle: true;
    disable-history: false;
    drun-display-format: "{name}";
    display-drun: "Search";
    display-run: "Run";
    display-window: "Windows";
    font: "JetBrainsMono Nerd Font Propo 12";
}

@theme "theme.rasi";

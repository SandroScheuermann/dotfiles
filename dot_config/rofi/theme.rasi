* {
    background: #18191cf2;
    background-alt: #222328f2;
    foreground: #e8e8ea;
    selected: #2d2f34;
    border: #34363c;
    active: #d4d4d6;
    urgent: #d2ad92;
}

window {
    width: 440px;
    border: 1px;
    border-color: @border;
    border-radius: 20px;
    background-color: @background;
    padding: 10px;
}

mainbox {
    children: [ inputbar, message, listview ];
    spacing: 8px;
}

inputbar {
    children: [ prompt, entry ];
    background-color: @background-alt;
    border: 1px;
    border-color: @border;
    border-radius: 12px;
    padding: 8px 11px;
}

prompt {
    text-color: @active;
    padding: 0 8px 0 0;
}

entry {
    text-color: @foreground;
    placeholder: "Search";
    placeholder-color: #9a9ca2;
}

listview {
    lines: 8;
    columns: 1;
    fixed-height: false;
    spacing: 2px;
}

element {
    padding: 7px 8px;
    border-radius: 10px;
    background-color: transparent;
    text-color: @foreground;
}

element selected {
    background-color: @selected;
    text-color: #ffffff;
}

element-text {
    text-color: inherit;
    vertical-align: 0.5;
}

element-icon {
    size: 24px;
    margin: 0 8px 0 0;
}

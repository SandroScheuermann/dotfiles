[module/caffeine]
type = custom/ipc
hook-0 = printf '\n'
hook-1 = printf '~\n'
hook-2 = printf '~/\n'
initial = 0
format = <output>
format-foreground = ${colors.primary}

[module/temperature]
type = custom/script
exec = {{ .chezmoi.homeDir }}/.config/i3/scripts/temperature.sh
interval = 4
label = %output%
label-foreground = ${colors.foreground}
label-padding = 1

[module/cpu]
type = internal/cpu
interval = 4
format = <label>
label = CPU %percentage%%
label-foreground = ${colors.foreground-alt}
label-padding = 1

[module/memory]
type = internal/memory
interval = 4
format = <label>
label = RAM %percentage_used%%
label-foreground = ${colors.foreground-alt}
label-padding = 1

[module/battery]
type = internal/battery
battery = BAT0
adapter = AC
poll-interval = 4
format-charging = <label-charging>
format-discharging = <label-discharging>
format-full = <label-full>
label-charging = BAT %percentage%%
label-discharging = BAT %percentage%%
label-full = BAT %percentage%%
label-foreground = ${colors.foreground-alt}
label-padding = 1

[module/brightness]
type = custom/script
exec = brightnessctl -m | awk -F, '{print $4}'
interval = 2
label = BRI %output%
label-foreground = ${colors.foreground-alt}
label-padding = 1
scroll-up = {{ .chezmoi.homeDir }}/.config/i3/scripts/brightness-set.sh up
scroll-down = {{ .chezmoi.homeDir }}/.config/i3/scripts/brightness-set.sh down

[module/power]
type = custom/script
exec = {{ .chezmoi.homeDir }}/.config/i3/scripts/power-profile.sh status
interval = 10
click-left = {{ .chezmoi.homeDir }}/.config/i3/scripts/power-profile.sh menu
label = %output%
label-foreground = ${colors.foreground-alt}
label-padding = 1

[module/audio]
type = internal/pulseaudio
use-ui-max = true
interval = 2
format-volume = <label-volume>
format-muted = <label-muted>
label-volume = VOL %percentage%%
label-muted = VOL muted
label-volume-foreground = ${colors.foreground}
label-muted-foreground = ${colors.foreground-alt}
label-volume-padding = 1
label-muted-padding = 1
click-left = pactl set-sink-mute @DEFAULT_SINK@ toggle
click-right = {{ .chezmoi.homeDir }}/.config/i3/scripts/audio-device-menu.sh output

[module/mic]
type = custom/script
exec = sh -c 'if pactl get-source-mute @DEFAULT_SOURCE@ | grep -q yes; then printf "MIC muted"; else printf "MIC on"; fi'
interval = 2
label = %output%
label-foreground = ${colors.foreground-alt}
label-padding = 1
click-left = pactl set-source-mute @DEFAULT_SOURCE@ toggle
click-right = {{ .chezmoi.homeDir }}/.config/i3/scripts/audio-device-menu.sh input

[module/clock]
type = internal/date
interval = 1
date = %a %b %d  %I:%M %p
date-alt = %Y-%m-%d %H:%M:%S
label = %date%
label-foreground = ${colors.foreground}
label-padding = 1
click-left = {{ .chezmoi.homeDir }}/.config/i3/scripts/notification-panel.sh

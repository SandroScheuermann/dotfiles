tail = true
label = %output%
click-left = {{ .chezmoi.homeDir }}/.config/i3/scripts/workspace-domains.sh focus 1
scroll-up = {{ .chezmoi.homeDir }}/.config/i3/scripts/workspace-domains.sh previous
scroll-down = {{ .chezmoi.homeDir }}/.config/i3/scripts/workspace-domains.sh next

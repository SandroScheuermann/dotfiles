include-file = {{ .chezmoi.homeDir }}/.config/polybar/colors.ini

[settings]
screenchange-reload = true
pseudo-transparency = true

[bar/main]
monitor = ${env:MONITOR:}
width = 100%
height = 40
offset-y = 8
fixed-center = true
wm-restack = i3
enable-ipc = true
background = ${colors.background}
foreground = ${colors.foreground}
line-size = 2
line-color = ${colors.primary}
border-size = 1
border-color = ${colors.border}
padding-left = 8
padding-right = 8
module-margin = 0
font-0 = JetBrainsMono Nerd Font Propo:size=10;2
font-1 = Noto Sans:size=10;2
modules-left = caffeine
modules-center = domain workspace-1 workspace-2 workspace-3 workspace-4 workspace-5 workspace-6 workspace-7 workspace-8 workspace-9 workspace-10
modules-right = temperature cpu memory{{ if and (eq .machineType "notebook") (stat "/sys/class/power_supply/BAT0") }} battery{{ end }}{{ if and (eq .machineType "notebook") (stat "/sys/class/backlight/intel_backlight") }} brightness{{ end }} audio mic clock
cursor-click = pointer
cursor-scroll = ns-resize

[module/domain]
type = custom/script
exec = {{ .chezmoi.homeDir }}/.config/i3/scripts/workspace-status.sh domain
tail = true
format = <label>
label = %output%
label-foreground = ${colors.primary}
label-padding = 1

[module/workspace-1]

local mainMod = "SUPER"
local terminal = "kitty"
local fileManager = "kitty -e yazi"
local menu = "{{ .chezmoi.homeDir }}/.config/hypr/scripts/launcher.sh"
local workspaceScript = "{{ .chezmoi.homeDir }}/.config/hypr/scripts/workspace-switch.sh"
local barMinimal = "{{ .chezmoi.homeDir }}/.config/hypr/scripts/waybar-domain.sh"

hl.bind(mainMod .. " + T", hl.dsp.exec_cmd(terminal))
hl.bind(mainMod .. " + Q", function()
    local special = hl.get_active_special_workspace()

    if special == nil then
        hl.dispatch(hl.dsp.window.close())
        return
    end

    hl.exec_cmd(workspaceScript .. " focus 1")
end)
hl.bind(mainMod .. " + SHIFT + Q", hl.dsp.window.kill())
hl.bind(mainMod .. " + E", hl.dsp.exec_cmd(fileManager))
hl.bind(mainMod .. " + SHIFT + V", hl.dsp.window.float({ action = "toggle" }))
hl.bind(mainMod .. " + V", hl.dsp.exec_cmd("{{ .chezmoi.homeDir }}/.config/hypr/scripts/clipboard-menu.sh"))
hl.bind(mainMod .. " + R", hl.dsp.exec_cmd(menu))
hl.bind(mainMod .. " + CTRL + L", hl.dsp.exec_cmd("hyprlock"))
hl.bind(mainMod .. " + N", hl.dsp.exec_cmd("{{ .chezmoi.homeDir }}/.config/hypr/scripts/night-toggle.sh"))
hl.bind(mainMod .. " + O", hl.dsp.exec_cmd("{{ .chezmoi.homeDir }}/.config/hypr/scripts/obsidian-special.sh"))

for slot = 1, 10 do
    local key = slot == 10 and "0" or tostring(slot)
    hl.bind(mainMod .. " + " .. key, hl.dsp.exec_cmd(workspaceScript .. " focus " .. slot))
    hl.bind(mainMod .. " + SHIFT + " .. key, hl.dsp.exec_cmd(workspaceScript .. " move " .. slot))
end

hl.bind(mainMod .. " + F1", hl.dsp.exec_cmd(workspaceScript .. " domain 1"))
hl.bind(mainMod .. " + F2", hl.dsp.exec_cmd(workspaceScript .. " domain 2"))

hl.bind(mainMod .. " + SHIFT + L", hl.dsp.window.resize({ x = 20, y = 0, relative = true }), { repeating = true })
hl.bind(mainMod .. " + SHIFT + H", hl.dsp.window.resize({ x = -20, y = 0, relative = true }), { repeating = true })
hl.bind(mainMod .. " + SHIFT + K", hl.dsp.window.resize({ x = 0, y = -20, relative = true }), { repeating = true })
hl.bind(mainMod .. " + SHIFT + J", hl.dsp.window.resize({ x = 0, y = 20, relative = true }), { repeating = true })
hl.bind(mainMod .. " + BACKSPACE", hl.dsp.exec_cmd("hyprctl dispatch resizewindowpixel reset"))
hl.bind(mainMod .. " + H", hl.dsp.focus({ direction = "l" }))
hl.bind(mainMod .. " + L", hl.dsp.focus({ direction = "r" }))
hl.bind(mainMod .. " + K", hl.dsp.focus({ direction = "u" }))
hl.bind(mainMod .. " + J", hl.dsp.focus({ direction = "d" }))
hl.bind(mainMod .. " + F", hl.dsp.window.fullscreen({ mode = "maximized", action = "toggle" }))
hl.bind(mainMod .. " + SHIFT + S", hl.dsp.exec_cmd("hyprshot --freeze -m region --clipboard-only"))
hl.bind(mainMod .. " + S", hl.dsp.exec_cmd("hyprshot -m window --clipboard-only"))

hl.on("hyprland.start", function()
{{ if eq .machineType "desktop" }}
    hl.exec_cmd("powerprofilesctl set performance")
{{ end }}
    hl.exec_cmd(barMinimal)
    hl.exec_cmd("hyprpaper")
    hl.exec_cmd("hyprlauncher --daemon --quiet")
    hl.exec_cmd("command -v wl-paste >/dev/null 2>&1 && command -v cliphist >/dev/null 2>&1 && wl-paste --type text --watch cliphist store")
end)

local function syncWorkspaceDomains()
    hl.exec_cmd(workspaceScript .. " sync")
end

hl.on("workspace.active", syncWorkspaceDomains)
hl.on("window.open", syncWorkspaceDomains)
hl.on("window.destroy", syncWorkspaceDomains)
hl.on("window.move_to_workspace", syncWorkspaceDomains)

hl.config({
    general = {
        gaps_in = 8,
        gaps_out = 14,
        border_size = 1,
        col = {
            active_border = "rgba(ffffff28)",
            inactive_border = "rgba(ffffff14)",
        },
        resize_on_border = true,
    },
    decoration = {
        rounding = 20,
        active_opacity = 1.0,
        inactive_opacity = 1.0,
        fullscreen_opacity = 1.0,
        dim_around = 0.62,
        shadow = {
            enabled = true,
            range = 18,
            render_power = 2,
            color = "rgba(00000055)",
        },
        blur = {
            enabled = false,
            size = 1,
            passes = 1,
            new_optimizations = true,
            ignore_opacity = false,
            xray = false,
        },
    },
    animations = {
        enabled = true,
    },
    misc = {
        disable_hyprland_logo = true,
        disable_splash_rendering = true,
        focus_on_activate = true,
    },
    input = {
        kb_layout = "us",
        kb_variant = "intl",
        kb_model = "pc105",
        follow_mouse = 1,
        sensitivity = 0,
        accel_profile = "flat",
        force_no_accel = true,
        touchpad = {
            natural_scroll = true,
            tap_to_click = true,
        },
    },
    xwayland = {
        force_zero_scaling = true,
    },
})

hl.curve("smooth", { type = "bezier", points = { {0.16, 1}, {0.3, 1} } })
hl.curve("soft", { type = "bezier", points = { {0.2, 0.8}, {0.2, 1} } })

hl.animation({ leaf = "windows", enabled = true, speed = 2, bezier = "smooth", style = "slidefade" })
hl.animation({ leaf = "windowsOut", enabled = true, speed = 2, bezier = "soft", style = "slidefade" })
hl.animation({ leaf = "border", enabled = true, speed = 5, bezier = "soft" })
hl.animation({ leaf = "fade", enabled = true, speed = 4, bezier = "soft" })
hl.animation({ leaf = "workspaces", enabled = true, speed = 2, bezier = "soft", style = "slidefade" })

hl.window_rule({
    name = "obsidian-special-workspace",
    match = { class = "^md\\.Obsidian$" },
    workspace = "special:obsidian",
})

for _, namespace in ipairs({ "wlogout", "hyprlauncher", "wofi", "swaync-control-center" }) do
    hl.layer_rule({
        match = { namespace = namespace },
        dim_around = true,
    })
end

if hl.plugin.hyprglass ~= nil then
    hl.config({
        plugin = {
            hyprglass = {
                enabled = false,
                layers = {
                    enabled = false,
                },
            },
        },
    })
end

syncWorkspaceDomains()

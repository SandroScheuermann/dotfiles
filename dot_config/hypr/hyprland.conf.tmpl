
$mainMod = SUPER
$terminal = kitty
$fileManager = kitty -e yazi
$menu = {{ .chezmoi.homeDir }}/.config/hypr/scripts/launcher.sh
$bar = waybar
$barminimal = waybar -c {{ .chezmoi.homeDir }}/repos/waybarcfgs/minimal-waybar/waybar/config-simple -s {{ .chezmoi.homeDir }}/repos/waybarcfgs/minimal-waybar/waybar/style-simple.css &

bind = $mainMod, T, exec, $terminal
bind = $mainMod, Q, killactive,
bind = $mainMod SHIFT, Q, exec, kill -9 $(hyprctl activewindow | grep pid | tail -1 | awk '{print$2}')
bind = $mainMod, E, exec, $fileManager
bind = $mainMod SHIFT, V, togglefloating,
bind = $mainMod, V, exec, {{ .chezmoi.homeDir }}/.config/hypr/scripts/clipboard-menu.sh
bind = $mainMod, R, exec, $menu
bind = $mainMod CTRL, L, exec, hyprlock
bind = $mainMod, N, exec, {{ .chezmoi.homeDir }}/.config/hypr/scripts/night-toggle.sh

bind = $mainMod, 1, workspace, 1
bind = $mainMod, 2, workspace, 2
bind = $mainMod, 3, workspace, 3
bind = $mainMod, 4, workspace, 4
bind = $mainMod, 5, workspace, 5
bind = $mainMod, 6, workspace, 6
bind = $mainMod, 7, workspace, 7
bind = $mainMod, 8, workspace, 8
bind = $mainMod, 9, workspace, 9
bind = $mainMod SHIFT, 1, movetoworkspace, 1
bind = $mainMod SHIFT, 2, movetoworkspace, 2
bind = $mainMod SHIFT, 3, movetoworkspace, 3
bind = $mainMod SHIFT, 4, movetoworkspace, 4
bind = $mainMod SHIFT, 5, movetoworkspace, 5
bind = $mainMod SHIFT, 6, movetoworkspace, 6
bind = $mainMod SHIFT, 7, movetoworkspace, 7
bind = $mainMod SHIFT, 8, movetoworkspace, 8
bind = $mainMod SHIFT, 9, movetoworkspace, 9
binde = $mainMod SHIFT, L, resizeactive, 20 0
binde = $mainMod SHIFT, H, resizeactive, -20 0
binde = $mainMod SHIFT, K, resizeactive, 0 -20
binde = $mainMod SHIFT, J, resizeactive, 0 20
bind = $mainMod, BACKSPACE, resizewindowpixel, reset
bind = $mainMod, H, movefocus, l
bind = $mainMod, L, movefocus, r
bind = $mainMod, K, movefocus, u
bind = $mainMod, J, movefocus, d
bind = $mainMod, F, fullscreen, 1
bind = SHIFT, Print, exec, env WAYLAND_DISPLAY=wayland-1 hyprshot -m region --clipboard-only
bind = $mainMod, Print, exec, env WAYLAND_DISPLAY=wayland-1 hyprshot -m window --clipboard-only
bind = , Print, exec, env WAYLAND_DISPLAY=wayland-1 hyprshot -m output --clipboard-only


exec-once = $barminimal 
exec-once = hyprpaper
exec-once = hyprlauncher --daemon --quiet >/dev/null 2>&1
exec-once = command -v wl-paste >/dev/null 2>&1 && command -v cliphist >/dev/null 2>&1 && wl-paste --type text --watch cliphist store

general {
    gaps_in = 5
    gaps_out = 8
    border_size = 1
    col.active_border = rgba(589df6cc)
    col.inactive_border = rgba(ffffff18)
    resize_on_border = true
}

decoration {
    rounding = 12
    active_opacity = 1.0
    inactive_opacity = 0.96
    fullscreen_opacity = 1.0
    dim_around = 0.72
    shadow {
        enabled = true
        range = 18
        render_power = 2
        color = rgba(0000003f)
    }

    blur {
        enabled = true
        size = 6
        passes = 3
        new_optimizations = true
        ignore_opacity = true
        xray = false
    }
}

animations {
    enabled = true
    bezier = glass, 0.16, 1, 0.3, 1
    bezier = soft, 0.2, 0.8, 0.2, 1

    animation = windows, 1, 2, glass, slidefade
    animation = windowsOut, 1, 2, soft, slidefade
    animation = border, 1, 5, soft
    animation = fade, 1, 4, soft
    animation = workspaces, 1, 2, soft, slidefade
}

misc {
    disable_hyprland_logo = true
    disable_splash_rendering = true
    focus_on_activate = true
}

input {
    kb_layout = us
    kb_variant = intl
    kb_model = pc105
    follow_mouse = 1
    touchpad {
        natural_scroll = true
        tap-to-click = true
    }
}

xwayland {
	force_zero_scaling = true
}

layerrule[waybar] = blur true
layerrule[waybar] = ignorealpha 0.25
layerrule[wlogout] = blur true
layerrule[wlogout] = ignorealpha 0.25
layerrule[wlogout] = dimaround true
layerrule[swaync-control-center] = blur true
layerrule[swaync-control-center] = ignorealpha 0.25
layerrule[swaync-control-center] = dimaround true
layerrule[swaync-notification-window] = blur true
layerrule[swaync-notification-window] = ignorealpha 0.25

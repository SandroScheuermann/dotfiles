[global]
    monitor = 0
    follow = mouse
    width = 220
    height = (0, 72)
    origin = top-left
    offset = (8, 48)
    scale = 0
    notification_limit = 3
    indicate_hidden = yes
    progress_bar = false
    transparency = 0
    separator_height = 1
    padding = 5
    horizontal_padding = 8
    frame_width = 1
    frame_color = "#34363c"
    separator_color = frame
    sort = yes
    idle_threshold = 120
    font = JetBrainsMono Nerd Font Propo 8
    line_height = 0
    markup = full
    format = "%s"
    alignment = left
    vertical_alignment = center
    show_age_threshold = 60
    word_wrap = yes
    ellipsize = middle
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = yes
    sticky_history = yes
    history_length = 20
    browser = xdg-open
    icon_theme = Papirus
    corner_radius = 8
    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

[urgency_low]
    background = "#18191c"
    foreground = "#9a9ca2"
    timeout = 3

[urgency_normal]
    background = "#222328"
    foreground = "#e8e8ea"
    timeout = 4

[urgency_critical]
    background = "#4b3529"
    foreground = "#ffffff"
    frame_color = "#d2ad92"
    timeout = 0

// ██║ █╗ ██║███████║ ╚████╔╝ ██████╔╝███████║██████╔╝
// ██║███╗██║██╔══██║  ╚██╔╝  ██╔══██╗██╔══██║██╔══██╗
// ╚███╔███╔╝██║  ██║   ██║   ██████╔╝██║  ██║██║  ██║
//  ╚══╝╚══╝ ╚═╝  ╚═╝   ╚═╝   ╚═════╝ ╚═╝  ╚═╝╚═╝  ╚═╝
//                          A config for simple waybar

{
  "layer": "top",
  "position": "top",
  "modules-left": ["custom/logo", "hyprland/language"],
  "modules-center": ["group/workspaces"],
    "modules-right": [
      "custom/caffeine",
      "temperature",
      "cpu",
      "memory",
{{ if and (eq .machineType "notebook") (stat "/sys/class/power_supply/BAT0") }}
      "group/power-profile",
{{ end }}
{{ if and (eq .machineType "notebook") (stat "/sys/class/backlight/intel_backlight") }}
      "backlight",
{{ end }}
      "pulseaudio#source",
      "pulseaudio#mic",
      "clock"
    ],
  "reload_style_on_change": true,

    "hyprland/language": {
      "format": "{}",
      "format-en": "en",
      "format-my": "mm",
      "on-click": "hyprctl switchxkblayout at-translated-set-2-keyboard next",
      "tooltip": false,
    },

    "group/workspaces": {
      "orientation": "horizontal",
      "modules": [
        "custom/workspace-1",
        "custom/workspace-2",
        "custom/workspace-3",
        "custom/workspace-4",
        "custom/workspace-5",
        "custom/workspace-6",
        "custom/workspace-7",
        "custom/workspace-8",
        "custom/workspace-9",
        "custom/workspace-10"
      ]
    },

    "custom/workspace-1": {
      "exec": "{{ .chezmoi.homeDir }}/.config/hypr/scripts/workspace-switch.sh status 1",
      "return-type": "json",
      "signal": 8,
      "on-click": "{{ .chezmoi.homeDir }}/.config/hypr/scripts/workspace-switch.sh focus 1",
      "on-scroll-up": "{{ .chezmoi.homeDir }}/.config/hypr/scripts/workspace-switch.sh previous",
      "on-scroll-down": "{{ .chezmoi.homeDir }}/.config/hypr/scripts/workspace-switch.sh next"
    },
    "custom/workspace-2": {
      "exec": "{{ .chezmoi.homeDir }}/.config/hypr/scripts/workspace-switch.sh status 2",
      "return-type": "json",
      "signal": 8,
      "on-click": "{{ .chezmoi.homeDir }}/.config/hypr/scripts/workspace-switch.sh focus 2",
      "on-scroll-up": "{{ .chezmoi.homeDir }}/.config/hypr/scripts/workspace-switch.sh previous",
      "on-scroll-down": "{{ .chezmoi.homeDir }}/.config/hypr/scripts/workspace-switch.sh next"
    },
    "custom/workspace-3": {
      "exec": "{{ .chezmoi.homeDir }}/.config/hypr/scripts/workspace-switch.sh status 3",
      "return-type": "json",
      "signal": 8,
      "on-click": "{{ .chezmoi.homeDir }}/.config/hypr/scripts/workspace-switch.sh focus 3",
      "on-scroll-up": "{{ .chezmoi.homeDir }}/.config/hypr/scripts/workspace-switch.sh previous",
      "on-scroll-down": "{{ .chezmoi.homeDir }}/.config/hypr/scripts/workspace-switch.sh next"
    },
    "custom/workspace-4": {
      "exec": "{{ .chezmoi.homeDir }}/.config/hypr/scripts/workspace-switch.sh status 4",
      "return-type": "json",
      "signal": 8,
      "on-click": "{{ .chezmoi.homeDir }}/.config/hypr/scripts/workspace-switch.sh focus 4",
      "on-scroll-up": "{{ .chezmoi.homeDir }}/.config/hypr/scripts/workspace-switch.sh previous",
      "on-scroll-down": "{{ .chezmoi.homeDir }}/.config/hypr/scripts/workspace-switch.sh next"
    },
    "custom/workspace-5": {
      "exec": "{{ .chezmoi.homeDir }}/.config/hypr/scripts/workspace-switch.sh status 5",
      "return-type": "json",
      "signal": 8,
      "on-click": "{{ .chezmoi.homeDir }}/.config/hypr/scripts/workspace-switch.sh focus 5",
      "on-scroll-up": "{{ .chezmoi.homeDir }}/.config/hypr/scripts/workspace-switch.sh previous",
      "on-scroll-down": "{{ .chezmoi.homeDir }}/.config/hypr/scripts/workspace-switch.sh next"
    },
    "custom/workspace-6": {
      "exec": "{{ .chezmoi.homeDir }}/.config/hypr/scripts/workspace-switch.sh status 6",
      "return-type": "json",
      "signal": 8,
      "on-click": "{{ .chezmoi.homeDir }}/.config/hypr/scripts/workspace-switch.sh focus 6",
      "on-scroll-up": "{{ .chezmoi.homeDir }}/.config/hypr/scripts/workspace-switch.sh previous",
      "on-scroll-down": "{{ .chezmoi.homeDir }}/.config/hypr/scripts/workspace-switch.sh next"
    },
    "custom/workspace-7": {
      "exec": "{{ .chezmoi.homeDir }}/.config/hypr/scripts/workspace-switch.sh status 7",
      "return-type": "json",
      "signal": 8,
      "on-click": "{{ .chezmoi.homeDir }}/.config/hypr/scripts/workspace-switch.sh focus 7",
      "on-scroll-up": "{{ .chezmoi.homeDir }}/.config/hypr/scripts/workspace-switch.sh previous",
      "on-scroll-down": "{{ .chezmoi.homeDir }}/.config/hypr/scripts/workspace-switch.sh next"
    },
    "custom/workspace-8": {
      "exec": "{{ .chezmoi.homeDir }}/.config/hypr/scripts/workspace-switch.sh status 8",
      "return-type": "json",
      "signal": 8,
      "on-click": "{{ .chezmoi.homeDir }}/.config/hypr/scripts/workspace-switch.sh focus 8",
      "on-scroll-up": "{{ .chezmoi.homeDir }}/.config/hypr/scripts/workspace-switch.sh previous",
      "on-scroll-down": "{{ .chezmoi.homeDir }}/.config/hypr/scripts/workspace-switch.sh next"
    },
    "custom/workspace-9": {
      "exec": "{{ .chezmoi.homeDir }}/.config/hypr/scripts/workspace-switch.sh status 9",
      "return-type": "json",
      "signal": 8,
      "on-click": "{{ .chezmoi.homeDir }}/.config/hypr/scripts/workspace-switch.sh focus 9",
      "on-scroll-up": "{{ .chezmoi.homeDir }}/.config/hypr/scripts/workspace-switch.sh previous",
      "on-scroll-down": "{{ .chezmoi.homeDir }}/.config/hypr/scripts/workspace-switch.sh next"
    },
    "custom/workspace-10": {
      "exec": "{{ .chezmoi.homeDir }}/.config/hypr/scripts/workspace-switch.sh status 10",
      "return-type": "json",
      "signal": 8,
      "on-click": "{{ .chezmoi.homeDir }}/.config/hypr/scripts/workspace-switch.sh focus 10",
      "on-scroll-up": "{{ .chezmoi.homeDir }}/.config/hypr/scripts/workspace-switch.sh previous",
      "on-scroll-down": "{{ .chezmoi.homeDir }}/.config/hypr/scripts/workspace-switch.sh next"
    },

    "custom/logo": {
      "format": "",
      "tooltip": true,
      "tooltip-format": "Power Options",
      "on-click": "wlogout -n -b 2 -c 0 -r 0 -T 360 -B 360 -L 560 -R 760"
    },
    "custom/caffeine": {
      "exec": "{{ .chezmoi.homeDir }}/.local/bin/mouse-jiggler status",
      "return-type": "json",
      "interval": 2,
      "tooltip": true,
      "on-click": "{{ .chezmoi.homeDir }}/.local/bin/mouse-jiggler toggle"
    },
    "clock": {
      "tooltip": true,
      "tooltip-format": "Notification Center",
      "format": "{:%a %b %d  %I:%M %p}",
      "on-click": "swaync-client -t -w",
      "return-type": "json",
      "exec-if": "which swaync-client",
      "exec": "swaync-client -swb",
      "escape": true
    },
    "backlight": {
      "device": "intel_backlight",
      "format": "{icon} {percent}%",
      "format-icons": ["󰖨"],
      "scroll-step": 1,
      "tooltip": true,
      "tooltip-format": "Brightness: {percent}%",
      "on-scroll-up": "{{ .chezmoi.homeDir }}/repos/waybarcfgs/minimal-waybar/waybar/scripts/brightness-set.sh up",
      "on-scroll-down": "{{ .chezmoi.homeDir }}/repos/waybarcfgs/minimal-waybar/waybar/scripts/brightness-set.sh down"
    },

    "custom/brightness-level": {
      "exec": "brightnessctl -m | cut -d, -f4",
      "interval": 1,
      "signal": 9,
      "format": "{}",
      "tooltip": false,
      "on-scroll-up": "{{ .chezmoi.homeDir }}/repos/waybarcfgs/minimal-waybar/waybar/scripts/brightness-set.sh up",
      "on-scroll-down": "{{ .chezmoi.homeDir }}/repos/waybarcfgs/minimal-waybar/waybar/scripts/brightness-set.sh down"
    },

    "pulseaudio#source": {
      "format": "{icon} {volume}%",
      "format-muted": "<span foreground='#9a9ca2'>{icon} {volume}%</span>",
      "tooltip": true,
      "tooltip-format": "Volume: {volume}%",
      "format-icons": {
        "headphone": "󰋋",
        "default": ["", "", ""],
      },
      "scroll-step": 1,
      "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
      "on-click-right": "{{ .chezmoi.homeDir }}/.config/hypr/scripts/audio-device-menu.sh output"
    },

    "pulseaudio#mic": {
      "format": "{format_source}",
      "format-source-muted": "<span foreground='#9a9ca2'>󰍬</span>",
      "format-source": "<span foreground='white'>󰍬</span>",
      "on-click": "pactl set-source-mute @DEFAULT_SOURCE@ toggle",
      "on-click-right": "{{ .chezmoi.homeDir }}/.config/hypr/scripts/audio-device-menu.sh input",
      "tooltip": true,
      "tooltip-format": "Microphone Status"
    },

    "battery": {
      "bat": "BAT0",
      "format": "{icon} {capacity}%",
      "format-charging": "󱐋 {capacity}%",
      "format-plugged": "󱐋 {capacity}%",
      "format-icons": {
        "default": ["<span color='#7a7b80'></span>", "<span color='#9a9ca2'></span>", "", "", ""],
      },
      "format-full": "󰂄",
      "tooltip": true,
      "tooltip-format": "Battery: {capacity}%\n{time}\nClick to show power profiles",
      "interval": 4
    },

    "custom/power-saver": {
      "exec": "{{ .chezmoi.homeDir }}/repos/waybarcfgs/minimal-waybar/waybar/scripts/power-profile.sh power-saver",
      "return-type": "json",
      "interval": 10,
      "signal": 10,
      "tooltip": true,
      "on-click": "{{ .chezmoi.homeDir }}/repos/waybarcfgs/minimal-waybar/waybar/scripts/power-profile.sh power-saver set"
    },

    "custom/power-balanced": {
      "exec": "{{ .chezmoi.homeDir }}/repos/waybarcfgs/minimal-waybar/waybar/scripts/power-profile.sh balanced",
      "return-type": "json",
      "interval": 10,
      "signal": 10,
      "tooltip": true,
      "on-click": "{{ .chezmoi.homeDir }}/repos/waybarcfgs/minimal-waybar/waybar/scripts/power-profile.sh balanced set"
    },

    "custom/power-performance": {
      "exec": "{{ .chezmoi.homeDir }}/repos/waybarcfgs/minimal-waybar/waybar/scripts/power-profile.sh performance",
      "return-type": "json",
      "interval": 10,
      "signal": 10,
      "tooltip": true,
      "on-click": "{{ .chezmoi.homeDir }}/repos/waybarcfgs/minimal-waybar/waybar/scripts/power-profile.sh performance set"
    },

    "group/power-profile": {
      "orientation": "horizontal",
      "drawer": {
        "transition-duration": 400,
        "transition-to-left": true,
        "click-to-reveal": true
      },
       "modules": [
{{ if and (eq .machineType "notebook") (stat "/sys/class/power_supply/BAT0") }}
         "battery",
{{ end }}
         "custom/power-saver",
         "custom/power-balanced",
         "custom/power-performance"
       ]
    },

    "cpu": {
	    "interval": 4,
      "format": "CPU {usage}%",
      "tooltip": true,
      "tooltip-format": "CPU: {usage}%"
    },

    "memory": {
      "format": "RAM {percentage}%",
      "tooltip": true,
      "tooltip-format": "RAM: {percentage}% used / {used:0.1f}G of {total:0.1f}G",
      "interval": 4,
    },

    "disk": {
      "interval": 30,
      "unit": "GB",
      "format": "{specific_used:0.2f}G",
      "path": "/",
      "tooltip": true,
      "tooltip-format": "Root: Used {specific_used:0.2f}G / free {specific_free:0.2f}G",
    },

    "temperature": {
      "hwmon-path-abs": [
        "/sys/devices/pci0000:00/0000:00:18.3/hwmon",
        "/sys/devices/platform/coretemp.0/hwmon"
      ],
      "input-filename": "temp1_input",
      "critical-threshold": 80,
      "format-critical": "<span color='#ffffff'>{temperatureC}°C</span>",
      "format": "<span color='#f2f2f2'>{temperatureC}°C</span>",
      "tooltip": true,
      "tooltip-format": "Temperature: {temperatureC}°C",
      "interval": 4,
    }

} 

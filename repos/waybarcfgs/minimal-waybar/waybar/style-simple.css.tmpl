@import "themes/main.css";
@import url("file://{{ .chezmoi.homeDir }}/.cache/hypr/domain-waybar.css");

* {
  border: none;
  box-shadow: none;
  font-family: "JetBrainsMono Nerd Font Propo", "Noto Sans", sans-serif;
  font-feature-settings: '"zero", "ss01", "ss02", "ss03", "ss04", "ss05", "cv31"';
  font-size: 10px;
  min-height: 0;
}

window#waybar {
  background: transparent;
  color: @fg;
}

window#waybar > box {
  margin: 8px 12px 0px 12px;
  padding: 4px 6px;
  background: @domain_bg;
  border: 1px solid @domain_border;
  border-radius: 18px;
  box-shadow: none;
}

tooltip {
  background: @tooltip_bg;
  border: 1px solid @domain_border;
  border-radius: 14px;
}

tooltip label {
  color: @fg;
  padding: 6px 8px;
}

#custom-logo,
#language,
#window,
#custom-spotify,
#workspaces,
#custom-caffeine,
#temperature,
#cpu,
#memory,
#tray,
#battery,
#custom-power-saver,
#custom-power-balanced,
#custom-power-performance,
#backlight,
#pulseaudio,
#clock {
  background: transparent;
  border: 1px solid transparent;
  border-radius: 999px;
  color: @fg;
  margin: 0 2px;
  padding: 0 7px;
}

#custom-logo {
  color: @active;
  font-family: "JetBrainsMono Nerd Font Propo";
  font-size: 11px;
  padding: 0 10px;
}

#language {
  color: @fg_soft;
  padding: 0 6px;
}

#window {
  color: @fg_soft;
  padding: 0 12px;
}

window#waybar.empty #window {
  background: transparent;
  border-color: transparent;
}

#custom-spotify {
  color: @fg;
  padding: 0 12px;
}

#workspaces {
  padding: 0 5px;
}

#workspaces .module {
  background: transparent;
  border-radius: 999px;
  color: @workspace_inactive;
  margin: 2px 1px;
  padding: 0 5px;
}

#workspaces .module.active {
  background: @workspace_active;
  border: 1px solid @domain_border;
  color: @fg_alt;
}

#workspaces .module.hidden {
  font-size: 0;
  margin: 0;
  min-width: 0;
  padding: 0;
}

#workspaces .module.urgent {
  color: @urgent;
}

#workspaces .module:hover,
#custom-logo:hover,
#language:hover,
#custom-spotify:hover,
#custom-caffeine:hover,
#clock:hover,
#cpu:hover,
#temperature:hover,
#memory:hover,
#battery:hover,
#backlight:hover,
#pulseaudio:hover,
#custom-power-saver:hover,
#custom-power-balanced:hover,
#custom-power-performance:hover {
  background: @hover;
  color: @fg;
}

#temperature {
  color: @active;
}

#custom-caffeine {
  color: @fg_soft;
  font-family: "JetBrainsMono Nerd Font Propo";
  font-size: 12px;
  padding: 0 8px;
}

#custom-caffeine.active {
  background: @workspace_active;
  border-color: @domain_border;
}

#cpu,
#memory {
  color: @fg;
}

#battery.charging,
#battery.plugged {
  color: @good;
}

#battery.warning:not(.charging) {
  color: #9a9ca2;
}

#battery.critical:not(.charging) {
  color: #ffffff;
}

#custom-power-saver,
#custom-power-balanced,
#custom-power-performance {
  font-family: "JetBrainsMono Nerd Font Propo";
  padding: 0 7px;
}

#custom-power-saver.active,
#custom-power-balanced.active,
#custom-power-performance.active {
  background: #2d2f34;
  border-color: #5a5c63;
  color: #f2f2f2;
}

#tray {
  padding: 0 8px;
}

#backlight,
#pulseaudio {
  color: @fg;
}

#pulseaudio.muted {
  color: #ffffff;
}

#clock {
  color: @fg;
  font-weight: 700;
  padding: 0 9px;
}

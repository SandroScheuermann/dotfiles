{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "openai": {
      "options": {
        "setCacheKey": true
      }
    }
  },
  "permission": {
    "read": {
      "~/.config/opencode/gsd-core/*": "allow"
    },
    "external_directory": {
      "~/.config/opencode/gsd-core/*": "allow"
    }
  },
  "plugins": [
    "@tarquinen/opencode-dcp@latest",
    "@plannotator/opencode@latest"
  ]
}
